PORT=5050
JWT_SECRET=change-this-secret
# SQLite runs locally without a separate database service. Set DB_MODE=mysql to use MySQL.
DB_MODE=sqlite
OWNER_EMAIL=shivanshcollege2@gmail.com
ADMIN_EMAIL_ALLOWLIST=shivanshcollege2@gmail.com
GOOGLE_CLIENT_ID=
VENDOR_EMAILS=vendor.demo@example.test
VENDOR_PASSWORD=VendorPass123!
# Set a private password before first startup. Do not commit your .env file.
OWNER_PASSWORD=
OWNER_NAME=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=invoiceeye
MYSQL_USER=invoiceeye
MYSQL_PASSWORD=invoiceeye
MYSQL_ROOT_PASSWORD=rootpassword
SQLITE_PATH=server/db/invoiceeye.sqlite
UPLOAD_DIR=server/uploads
MAX_DOCUMENT_PAGES=20
NON_PO_INVOICE_POLICY=review
# Comma-separated browser origins permitted to call the API directly.
# CORS_ORIGIN=http://127.0.0.1:5173,https://your-demo.example
# Optional: the server automatically prefers its project .venv when available.
# Windows: PYTHON_BIN=C:\Users\<you>\AppData\Local\Programs\Python\Python313\python.exe
# Alternatively leave blank to auto-detect .venv\Scripts\python.exe or the system Python.
PYTHON_BIN=
# Set this if Tesseract is installed outside PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_LANGUAGE_CODE=en
WHATSAPP_GRAPH_API_VERSION=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
